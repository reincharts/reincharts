{
  "name": "@reincharts/docs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Reincharts documentation site (Fumadocs, static export to GitHub Pages).",
  "scripts": {
    "dev": "node scripts/generate.mjs && next dev",
    "build": "node scripts/generate.mjs && next build",
    "start": "node scripts/serve.mjs",
    "generate": "node scripts/generate.mjs",
    "typecheck": "node scripts/generate.mjs && fumadocs-mdx && tsc --noEmit && node scripts/check-snippets.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@reincharts/core": "workspace:*",
    "@reincharts/series": "workspace:*",
    "@reincharts/indicators": "workspace:*",
    "@reincharts/axes": "workspace:*",
    "@reincharts/coordinates": "workspace:*",
    "@reincharts/tooltip": "workspace:*",
    "@reincharts/annotations": "workspace:*",
    "@reincharts/interactive": "workspace:*",
    "@reincharts/datafeed": "workspace:*",
    "@reincharts/widget": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "fumadocs-core": "16.17.9",
    "fumadocs-ui": "16.17.9",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-typescript": "^5.6.0",
    "lucide-react": "^1.66.0",
    "d3-dsv": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.20.5",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3"
  }
}
