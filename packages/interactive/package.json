{
  "name": "@reincharts/interactive",
  "version": "2.0.0",
  "description": "Drawing tools and editing for Reincharts: trend lines, fibonacci, channels, shapes, measure and more.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reincharts/reincharts.git",
    "directory": "packages/interactive"
  },
  "homepage": "https://reincharts.com",
  "bugs": {
    "url": "https://github.com/reincharts/reincharts/issues"
  },
  "keywords": [
    "react",
    "chart",
    "charts",
    "financial",
    "trading",
    "candlestick",
    "canvas",
    "stock",
    "technical-analysis"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit --passWithNoTests",
    "test:visual": "vitest run --project browser --passWithNoTests"
  },
  "dependencies": {
    "@reincharts/core": "workspace:*"
  },
  "devDependencies": {
    "@reincharts/testing": "workspace:*",
    "@reincharts/axes": "workspace:*",
    "@reincharts/series": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
